// ============================================
// CEOSMOS — Prisma Schema (Prisma v5)
// ============================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  username            String     @unique
  passwordHash        String?
  emailVerified       Boolean    @default(false)
  role                Role       @default(USER)
  active              Boolean    @default(true)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  passkeys    Passkey[]
  sessions    Session[]
  emailTokens EmailToken[]
  preferences Preferences?
  mediaItems  MediaItem[]
  tasks       Task[]
  auditLogs   AuditLog[]

  // CEOSMOS Móvil Integral
  focusSessions FocusSession[]
  favorites     Favorite[]
  linkedDevices LinkedDevice[]
}

model Passkey {
  credentialId   String   @id
  userId         String
  webAuthnUserId String
  publicKey      Bytes
  counter        BigInt
  deviceType     String
  backedUp       Boolean  @default(false)
  transports     String[]
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Login (borra las sesiones previas) y /users/me/sessions buscan por usuario (P11-D03).
  @@index([userId])
}

model EmailToken {
  id        String         @id @default(uuid())
  userId    String
  code      String
  type      EmailTokenType
  expiresAt DateTime
  used      Boolean        @default(false)
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model Preferences {
  id              String   @id @default(uuid())
  userId          String   @unique
  theme           String   @default("dark")
  flowTimeDefault Int      @default(60)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MediaItem {
  id         String    @id @default(uuid())
  userId     String
  type       MediaType
  externalId String?
  url        String?
  title      String?
  thumbnail  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Biblioteca por usuario ordenada por fecha (P11-D03).
  @@index([userId, createdAt])
}

enum MediaType {
  YOUTUBE
  IMAGE
}

enum TaskStatus {
  PENDIENTE
  COMPLETADA
}

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  USER_CREATE
  USER_DELETE
  ROLE_CHANGE
  USER_STATUS_CHANGE
}

model AuditLog {
  id        String       @id @default(uuid())
  userId    String?
  action    AuditAction
  timestamp DateTime     @default(now())
  ipAddress String?
  metadata  Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([timestamp])
}

enum TaskPriority {
  BAJA
  MEDIA
  ALTA
}

model Task {
  id          String       @id @default(uuid())
  userId      String
  title       String
  description String?
  status      TaskStatus   @default(PENDIENTE)
  priority    TaskPriority @default(MEDIA)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ============================================
// CEOSMOS Móvil Integral (sesiones de enfoque, favoritos y dispositivos)
// ============================================

enum FocusMode {
  FOCUS
  RELAX
  INSPIRE
}

/// Sesión de enfoque (distinta de Session, que es la sesión de autenticación).
model FocusSession {
  id              String    @id @default(uuid())
  userId          String
  /// Contenido usado: id del catálogo incluido en la app o "media:<MediaItem.id>".
  contentKey      String
  mode            FocusMode
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int
  targetMinutes   Int
  completed       Boolean   @default(false)
  /// Datos variables (p. ej. métricas del wearable durante la sesión).
  metadata        Json?
  /// UUID generado por la app antes del primer envío: hace idempotente el reintento (P11-D01).
  clientId        String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@unique([userId, clientId])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  contentKey String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentKey])
}

enum DeviceType {
  WEARABLE
  TV
}

enum DeviceTransport {
  TCP
  BLE
}

model LinkedDevice {
  id            String          @id @default(uuid())
  userId        String
  name          String
  type          DeviceType
  transport     DeviceTransport @default(TCP)
  /// host:puerto para TCP o dirección MAC para BLE.
  address       String
  /// Configuración variable del dispositivo (JSONB).
  configuration Json?
  lastSeenAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, address])
  @@index([userId])
}
